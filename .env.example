# Copy to .env.local for local dev. On Netlify, set these under
# Site configuration → Environment variables (never commit real values).

# Server-only. Never prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional. Comma-separated models tried first; the fast defaults are always added as fallbacks.
# Leave empty unless you have a reason. Avoid gemini-flash-latest: it measured 40–70s per answer.
GEMINI_MODEL=
# Optional bot check (Cloudflare Turnstile). Set both keys or neither.
TURNSTILE_SECRET_KEY=

# Public (baked into the page at build time, so redeploy after changing).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
